# ================================
# BuildBot - AI App Generator
# Environment Variables Configuration
# ================================

# ---- Application Config ----

# Defines the environment the application is running in.
# Valid values: "development", "production", "test"
# In "development", Prisma logs queries and errors to the console.
NODE_ENV="development"

# Port on which the Next.js server runs (optional, defaults to 3000)
# PORT=3000

# ---- Database Config ----

# The connection string for the PostgreSQL database.
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]?schema=[schema]
# If deploying to Neon or Supabase, copy the connection string here.
# Note: For Serverless deployments (Vercel) with Neon, append ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildbot?schema=public"

# Critical fix for Prisma v7 when running standalone tsx scripts (e.g. seeding)
# Ensures Prisma client loads correctly without driver adapters.
PRISMA_CLIENT_ENGINE_TYPE="library"

# ---- Authentication & Security (JWT) ----

# Secret key used to sign short-lived Access Tokens.
# Must be a long, cryptographically secure random string in production!
# e.g., openssl rand -base64 32
JWT_SECRET="change-me-to-a-strong-secret-in-production"

# Secret key used to sign long-lived Refresh Tokens.
# Must be DIFFERENT from JWT_SECRET in production.
JWT_REFRESH_SECRET="change-me-to-a-different-strong-secret"

# Lifespan of the Access Token.
# Format: "15m" (15 minutes), "1h" (1 hour), etc.
JWT_EXPIRES_IN="15m"

# Lifespan of the Refresh Token.
# Format: "7d" (7 days), "30d" (30 days).
JWT_REFRESH_EXPIRES_IN="7d"

# ---- AI Integration (Providers) ----

# Set the active AI Provider. Valid options: "openai", "groq", "gemini"
AI_PROVIDER="openai"

# (Optional) Fallback provider if the primary provider fails.
# AI_FALLBACK_PROVIDER="groq"

# OpenAI Configuration
# The app requires an account funded for 'gpt-4o' usage.
OPENAI_API_KEY="sk-your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o"

# Groq Configuration
# GROQ_API_KEY="gsk-your-groq-api-key-here"
# GROQ_MODEL="llama-3.3-70b-versatile"

# Gemini Configuration
# GEMINI_API_KEY="AIzaSy-your-gemini-api-key-here"
# GEMINI_MODEL="gemini-1.5-pro"

# ---- Runtime & Seeding Config ----

# Rate limiting settings (Optional/Future implementation)
# MAX_REQUESTS_PER_MINUTE=60
