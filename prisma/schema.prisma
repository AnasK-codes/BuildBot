// ============================================================
// BuildBot — Prisma Schema
// ============================================================
// C1: Lovable-style Website Generator
// Models: User, RefreshToken, Project, GeneratedVersion, GeneratedFile
// ============================================================

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  refreshTokens RefreshToken[]
  projects      Project[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// --- Website Generator Models (C1) ---

model Project {
  id             String   @id @default(cuid())
  userId         String
  title          String          // Derived from prompt or AI-generated
  prompt         String          // Original user prompt
  status         String          // "GENERATING" | "READY" | "ERROR"
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions GeneratedVersion[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("projects")
}

model GeneratedVersion {
  id               String   @id @default(cuid())
  projectId        String
  version          Int             // Sequential: 1, 2, 3...
  prompt           String          // The prompt that produced this version
  parentVersion    Int?            // null for v1, points to parent for refinements
  status           String          // "VALID" | "INVALID" | "GENERATING"
  validationReport Json?           // Structured validation results
  createdAt        DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   GeneratedFile[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("generated_versions")
}

model GeneratedFile {
  id        String @id @default(cuid())
  versionId String
  path      String        // "index.html" | "style.css" | "script.js"
  content   String        // Full file content (stored as TEXT)
  language  String        // "html" | "css" | "javascript"
  sizeBytes Int           // Content length in bytes
  checksum  String        // SHA-256 hash for diffing

  version GeneratedVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, path])
  @@index([versionId])
  @@map("generated_files")
}
